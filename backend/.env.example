# Porta do servidor (opcional; padrão 4000)
PORT=4000

# --- Banco de dados ---
# Se definido, usa PostgreSQL (ex.: Supabase). Caso contrário, usa SQLite em backend/data/catalog.db
# DATABASE_URL=postgresql://usuario:senha@host:5432/database?sslmode=require

# Apenas para SQLite (opcional):
# DB_DIR=./data
# DB_PATH=./data/catalog.db

# --- E-mail (notificação de pedidos) ---
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu-email@exemplo.com
# SMTP_PASS=senha-do-email
# E-mail que receberá o resumo de cada pedido (opcional; padrão: SMTP_USER)
# ORDER_NOTIFY_TO=pedidos@exemplo.com
